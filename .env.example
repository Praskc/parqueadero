# Variables del stack completo
#
# `pnpm mqtt:provision` y `docker compose up --build` generan este archivo
# solos, con claves aleatorias. Solo hace falta crearlo a mano si vas a
# levantar el compose sin aprovisionamiento previo.
#
# .env está en .gitignore: nunca lo subas al repositorio.

# Usuario del backend en el broker. Debe coincidir con broker/nodos.json.
MQTT_USER=backend

# Clave del usuario anterior. Si queda vacía, el broker no arranca.
MQTT_PASS=

# Clave del panel de operador. Mínimo 12 caracteres o el servidor no arranca.
ADMIN_TOKEN=

# Los nodos sensores (listener 8883 con mTLS) vienen habilitados.
# Ponlo en 0 mientras no haya ninguno conectado.
NODES_LISTENER=1
